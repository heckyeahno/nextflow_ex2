docker {
    enabled = true
    runOptions = "--entrypoint=''"
}

process {
    withName: downloadTree {
        container = 'evolbioinfo/ubuntu:v24.04'
    }
    withName: listTips {
        container = 'evolbioinfo/gotree:v0.4.1a'
    }
}

report {
    enabled = true
    file = 'reports/report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = 'reports/timeline.html'
    overwrite = true
}
